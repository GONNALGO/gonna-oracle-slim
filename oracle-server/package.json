{
  "name": "gonna-oracle-server",
  "version": "1.0.0",
  "private": true,
  "description": "GONNAFIGHT ARENA server oracle (M1) - signs scores and verdicts only after on-chain verification",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:testnet": "npm run build && node scripts/smoke-testnet.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "algosdk": "3.6.0",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.6.14",
    "tweetnacl": "1.0.3",
    "@libsql/client": "^0.14.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
